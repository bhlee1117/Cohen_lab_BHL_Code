cmap_ExTr=gen_colormap(Plasma,10);
for p=1:length(prcax)-1
    rangeVal=[prctile(bAPPropsMat{f,1}.TransmissionRate(bAPPropsMat{f,1}.Spike_Type==1),prcax(p)) prctile(bAPPropsMat{f,1}.TransmissionRate(bAPPropsMat{f,1}.Spike_Type==1),prcax(p+1))];
    showsp=find(bAPPropsMat{f,1}.TransmissionRate>rangeVal(1) & bAPPropsMat{f,1}.TransmissionRate<rangeVal(2) & bAPPropsMat{f,1}.Spike_Type==1);
    nexttile(p,[2 1])
    ShowAmp=mean(AlignedbAPall{f,2}(:,:,showsp),3,'omitnan');
    %ShowAmp=ShowAmp-median(ShowAmp(:,1:200),2,'omitnan');
    %ShowAmp=max(ShowAmp(:,200:205),[],2);
