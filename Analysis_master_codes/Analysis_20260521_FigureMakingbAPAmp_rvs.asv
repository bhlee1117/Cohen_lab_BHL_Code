    showDat((showDat(:,2)>50/3 | showDat(:,2)<-5/3),:)=[];
    %[M(f,:) S(f,:) t_center Ntmp]=binning_data_median({showDat},t_edge);
    [M(f,:) S(f,:) t_center Ntmp]=binning_data({showDat},t_edge);
    %Normconst=mean(M(f,end-4:end),2,'omitnan');
