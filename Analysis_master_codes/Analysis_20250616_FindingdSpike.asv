%% Load Result files
f=27;
f
load(fullfile(fpath{f}, 'PC_Result.mat'), 'Result')
branchInd=unique(Result.BranchLabel);
BranchTrace=NaN(length(branchInd),size(Result.normTraces,2));
BranchSpike=NaN(length(branchInd),size(Result.normTraces,2));

for b=branchInd
    ROI2mean=find(Result.BranchLabel==b);
    BranchTrace(b,:)=mean(Result.normTraces(ROI2mean,:),1,'omitnan');
end
zscoreTrace=BranchTrace./get_threshold(BranchTrace,1);
highpassTrace=zscoreTrace-movmedian(zscoreTrace,50,2);
BranchSpike=find_spike_bh(highpassTrace,4.5,3);

bAPframes=unique(find(Result.spike(1,:)>0)'+[0:4]);
BranchSpike(:,bAPframes)=0;
BranchSpike(:,Result.motionReject>0)=0;
dSpike2write=interactiveFrameCheck(zscoreTrace,BranchSpike>0,[200],'trace'); %check spike detection

Spike2update=Result.spike;
Spike2update(ref_ROI{f},:)=Spike2update(ref_ROI{f},:)+repmat(dSpike2write(1,:),length(ref_ROI{f}),1); %Add soma spike
for b=[2:max(branchInd)]
    ROI2write=find(Result.BranchLabel==b);
    Spike2update(ROI2write,:)=repmat(dSpike2write(b,:),length(ROI2write),1);
end

Result.spike=Spike2update;
dSpikeTrace=max(dSpike2write(2:end,:),[],1);
Result.SpClass(3,:)=dSpikeTrace;
bAPframes_updated=unique(find(Spike2update(1,:)>0)'+[0:4]);
Result.SpClass(3,bAPframes_updated)=0;

targetFile = strrep(fullfile(fpath{f},'PC_Result.mat'), '/Volumes/BHL18TB_D2/', '/Volumes/cohen_lab/Lab/Labmembers/Byung Hun Lee/Data/');
save(fullfile(fpath{f},'PC_Result.mat'),'Result','-v7.3')
save(targetFile,'Result','-v7.3')
disp(['Result is saved to ' targetFile]);


