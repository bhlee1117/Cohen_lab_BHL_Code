Et = EventTable(EventTable.Neuron==f,:);
evName = ["SS" "CS" "BS"];
clf; %tiledlayout(4,2);
sgtitle(['Subthreshold from ' num2str(presub_readtime(1)) ' ms to ' num2str(presub_readtime(end)) ' ms'])

cmapEv=hsv(3);
nexttile([1 1]);
