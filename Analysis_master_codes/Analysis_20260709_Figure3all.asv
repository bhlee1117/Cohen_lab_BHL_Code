    scatter(Et.TRfrst_bAP(isc),GlobalAmp(isc),20,cmapEv(sptype,:),'filled'); hold all;
end
validInd = ~isnan(Et.TRfrst_bAP) & ~isnan(GlobalAmp);
[r p]=corr(Et.TRfrst_bAP(validInd),GlobalAmp(validInd));
