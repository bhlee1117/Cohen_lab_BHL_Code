    str_ROI=str_ROI(DMDmask(sub2ind(sz,round(str_ROI(:,2)),round(str_ROI(:,1)))),:);
    str_ROI_rot=[[transformPointsForward(affine2d(Rmat),str_ROI(:,[1 2]))] str_ROI(:,3)];
