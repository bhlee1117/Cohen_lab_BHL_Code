take_window(end)=mod(f_seg(end),time_segment);
take_window(take_window==0)=time_segment;

mov_res_small_cat=[];
for j=soi(1):soi(2)%length(f_seg)-1
    j
    mov_mc=double(readBinMov_times([fpath{f} '/mc_ShutterReg' num2str(j,'%02d') '.bin'],sz(2),sz(1),[1:time_segment]));

    mc=Result.mcTrace(f_seg(j)+1:f_seg(j+1),:);
%    bleaching_exp=Result.SpikeHeight_fit(f_seg(j)+1:f_seg(j+1));
bkg(1,:) = linspace(-1, 1, size(mov_mc,3));  % linear term
bkg(2,:) = linspace(-1, 1, size(mov_mc,3)).^2;  % quadratic term

    mov_res = SeeResiduals(mov_mc,bkg);
    mov_res = SeeResiduals(mov_res,mc);
    mov_res = SeeResiduals(mov_res,mc.^2);
    mov_res = SeeResiduals(mov_res,mc(:,1).*mc(:,end));
    %mov_res = mov_res.*double(max(Result.bvMask,[],3)==0);

    mov_res_small=imresize(mov_res,1/2);
    sz_small=size(mov_res_small);
    mov_res_small_cat=cat(3,mov_res_small_cat,mov_res_small);
end

tr2corr=eigTrace_onFrame(toi,:)';
nonnanfrm=find(sum(isnan(tr2corr),1)==0);

corrImg=corr(tovec(mov_res_small_cat(:,:,nonnanfrm))',tr2corr(:,nonnanfrm)');
corrImg=toimg(corrImg,size(mov_res_small_cat,1),size(mov_res_small_cat,2));

