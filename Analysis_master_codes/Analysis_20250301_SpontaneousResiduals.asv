Residual
globalTrace
seesawTrace

PSD_sub=[];
for n=1:size(Subthreshold{f},1)
[freq PSD_sub(n,:)]=nanPSD(Subthreshold{f}(n,:),1000,10000);
end

%% Do this in movie domain
time_segment=15000; overlap=200;
load(fullfile(fpath{f},'PC_Result.mat'),'Result')
bound=4;
load([fpath{f} '/output_data.mat'])

soi=[9 15]; %interest segment;
sz=double(Device_Data{1, 3}.ROI([2 4]));
frm_end=EndFrame(f);
f_seg=[[1:time_segment:frm_end] frm_end+1]; f_seg(2:end)=f_seg(2:end)-1;
f_seg(1)=0;

toi=[f_seg(soi(1))+1:f_seg(soi(2)+1)]; %interest time;
take_window=repmat([1 time_segment],length(f_seg)-1,1);
take_window(2:end,1)=take_window(2:end,1)+overlap; take_window(1:end-1,2)=take_window(1:end-1,2)+overlap;
take_window(end)=mod(f_seg(end),time_segment);
take_window(take_window==0)=time_segment;

mov_res_small_cat=[];
for j=soi(1):soi(2)%length(f_seg)-1
    j
    mov_mc=double(readBinMov_times([fpath{f} '/mc_ShutterReg' num2str(j,'%02d') '.bin'],sz(2),sz(1),[1:time_segment]));

    mc=Result.mcTrace(f_seg(j)+1:f_seg(j+1),:);
    bleaching_exp=Result.SpikeHeight_fit(f_seg(j)+1:f_seg(j+1));

    mov_res = SeeResiduals(mov_mc,bleaching_exp);
    mov_res = SeeResiduals(mov_res,mc);
    mov_res = SeeResiduals(mov_res,mc.^2);
    mov_res = SeeResiduals(mov_res,mc(:,1).*mc(:,end));
    mov_res = mov_res.*double(max(Result.bvMask,[],3)==0);

    mov_res_small=imresize(mov_res,1/4);
    sz_small=size(mov_res_small);
    mov_res_small_cat=cat(3,mov_res_small_cat,mov_res_small);
end

eigTrace_sub=eigTrace_onFrame(toi,:);
ResidualTrace=Residual(:,toi);
%validFrame2=[sum(isnan(ResidualTrace),1)==0 | ~ismember([1:length(toi)],[12636:20000])];
validFrame2=[sum(isnan(ResidualTrace),1)==0];

mov_res_small_cat=get_subthreshold(tovec(mov_res_small_cat),Result.spike(1,toi),7,17);
mov_res_small_cat=toimg(mov_res_small_cat,sz_small(1),sz_small(2));

[V D eigTrace]=get_eigvector(tovec(mov_res_small_cat(bound:end-bound,bound:end-bound,validFrame2)),20);
V=toimg(V,sz_small(1)-2*bound+1,sz_small(2)-2*bound+1);
mov_res_Residual=[];
mov_res_Residual(:,:,validFrame2)=SeeResiduals(mov_res_small_cat(:,:,validFrame2),eigTrace(:,[1 2 3 5 17 19 20]));
mov_res_Residual(:,:,~validFrame2)=NaN;

ResidualImg=corr(tovec(-mov_res_Residual(bound:end-bound,bound:end-bound,validFrame2))',ResidualTrace(:,validFrame2)');
ResidualImg=toimg(ResidualImg,sz_small(1)-2*bound+1,sz_small(2)-2*bound+1);
ResidualImg=imresize(ResidualImg,4);

figure(15); clf;
ftprnt=imresize(Ftprnts{f}(:,:,Dist_order{f}(noi_dist{f})),1/4);
ftprnt=ftprnt(bound:end-bound,bound:end-bound,:);
ftprnt=imresize(ftprnt,4);
ResImg_vec=tovec(ResidualImg);

for n=[1 2 16 17]%1:37
    nexttile([1 1])
[cxy]=get_coord(ftprnt(:,:,n));
    imshow2(ResidualImg(:,:,n),[-0.1 0.3]); hold all

highpix=bwlabel(toimg(zscore(ResImg_vec(:,n))>3,size(ResidualImg,1),size(ResidualImg,2)));
highpix_prop=regionprops("table",highpix,'Area','Centroid');
highpix_prop.Area(find(distance_BH(double(highpix_prop.Centroid),cxy)>50))=0;
[~, maxlab]=max(double(highpix_prop.Area));
highpix=(highpix==maxlab);

FWHMpix=bwlabel(toimg(ResImg_vec(:,n)>max(ResImg_vec(highpix,n))/2,size(ResidualImg,1),size(ResidualImg,2)));
FWHMpix_prop=regionprops("table",FWHMpix,'Area','Centroid');
FWHMpix_prop.Area(find(distance_BH(double(FWHMpix_prop.Centroid),cxy)>50))=0;
[~, maxlab]=max(double(FWHMpix_prop.Area));
FWHMpix=(FWHMpix==maxlab);

[length, width, box] = measureRectangle(double(FWHMpix), 0);

%ftprnt_boundary=bwboundaries(ftprnt(:,:,n)>300);
%[~, arg]=max(cellfun(@(x) size(x,1),ftprnt_boundary));
%plot(ftprnt_boundary{arg}(:,2),ftprnt_boundary{arg}(:,1),'LineStyle','--')

scatter(cxy(1)-45,cxy(2),25,[1 0 1],'filled','>')
plot(box(:,2),box(:,1),'r','LineStyle','-.')
title(['Width: ' num2str(width*Pixelsize(f),3) '\mum Length: ' num2str(length*Pixelsize(f),3) ' \mum'])
end
colormap('bone')

