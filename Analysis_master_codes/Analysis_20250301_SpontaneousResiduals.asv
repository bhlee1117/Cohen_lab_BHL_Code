% title(['Fit func. : a*exp(bx)+c , 1/|b| = ' num2str(length_scale,3) ' \mum, R^2 = ' num2str(R_squared,3)])

Lap_Res=PlaceTrigger_average(Residual,150,VRtrack{f},-0.002,115); %total trace
Lap_Sub=PlaceTrigger_average(Subthreshold{f},150,VRtrack{f},-0.002,115); %total trace
globalTrace=pcafilterTrace(Subthreshold{f},[1]);
seesawTrace=pcafilterTrace(Subthreshold{f},[2]);

Lap_glob=PlaceTrigger_average(globalTrace,150,VRtrack{f},-0.002,115); %total trace
Lap_seesaw=PlaceTrigger_average(seesawTrace,150,VRtrack{f},-0.002,115); %total trace

%lap2mean={[3:11],[22:30]};
lap2mean={[3:21]};

figure(13); clf; tiledlayout(2,4)
[d ds]=sort(dendaxis{f});

for lm=1:length(lap2mean)
TC_Res=squeeze(mean(ringmovMean(Lap_Res(lap2mean{lm},:,:),3),1,'omitnan'));
TC_global=squeeze(mean(ringmovMean(Lap_glob(lap2mean{lm},:,:),3),1,'omitnan'));
TC_seesaw=squeeze(mean(ringmovMean(Lap_seesaw(lap2mean{lm},:,:),3),1,'omitnan'));
TC_sub=squeeze(mean(ringmovMean(Lap_Sub(lap2mean{lm},:,:),3),1,'omitnan'));
nexttile([1 1])
imagesc([1:150]/150*2,dendaxis{f}(ds),TC_sub(:,ds)')
shading flat; set(gca,'YDir','reverse'); 
title('Subthreshold')
xlabel('VR position (m)'); ylabel('Distance from soma (\mum)');

nexttile([1 1])
imagesc([1:150]/150*2,dendaxis{f}(ds),TC_global(:,ds)')
shading flat; set(gca,'YDir','reverse'); 
title('Subthreshold')
xlabel('VR position (m)'); ylabel('Distance from soma (\mum)');

nexttile([1 1])
imagesc([1:150]/150*2,dendaxis{f}(ds),TC_seesaw(:,ds)')
shading flat; set(gca,'YDir','reverse'); 
title('Subthreshold')
xlabel('VR position (m)'); ylabel('Distance from soma (\mum)');

nexttile([1 1])
imagesc([1:150]/150*2,dendaxis{f}(ds),TC_Res(:,ds)')
shading flat; set(gca,'YDir','reverse');
title('Residual'); 
xlabel('VR position (m)'); ylabel('Distance from soma (\mum)');
end


